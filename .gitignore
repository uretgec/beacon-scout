# ---- Build outputs & binaries (never commit) ----
*.exe
*.dll
bin/
build/bin/
build/windows/*.exe
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# ---- Frontend build artifacts (per-machine; rebuild with `npm run build`) ----
frontend/dist/
node_modules/
frontend/node_modules/

# ---- Wails generated bindings ----
# Regenerate on every machine with `wails3 generate bindings`.
# The committed placeholder stubs under frontend/bindings/github.com/uretgec/
# keep fresh clones compiling before generation.
/bindings/
/frontend/bindings/*
!/frontend/bindings/github.com/
/frontend/bindings/github.com/*
!/frontend/bindings/github.com/uretgec/
/frontend/bindings/github.com/uretgec/*
!/frontend/bindings/github.com/wailsapp/
/frontend/bindings/github.com/wailsapp/*

# ---- Taskfile local overrides ----
/taskfile.local.json
.task

# ---- Mobile per-machine generated (overlays contain absolute paths) ----
build/ios/xcode/overlay.json
build/ios/xcode/gen/
build/android/overlay.json
build/android/gen/

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
